<?xml version="1.0" encoding="utf-8"?>
<include>
  <context name="default">
    <extension name="kamailio_gateway_us">
      <condition field="destination_number" expression="^(1\d{10})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>
    
    <extension name="kamailio_gateway_ireland">
      <condition field="destination_number" expression="^(353\d{8,9})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>

    <extension name="kamailio_gateway_lithuania">
      <condition field="destination_number" expression="^(370\d{8})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>

    <extension name="kamailio_gateway_israel">
      <condition field="destination_number" expression="^(972\d{9})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>

    <extension name="kamailio_gateway_england">
      <condition field="destination_number" expression="^(44\d{10})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>

    <extension name="kamailio_gateway_denmark">
      <condition field="destination_number" expression="^(45\d{8})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>

    <extension name="kamailio_gateway_french">
      <condition field="destination_number" expression="^(33\d{9})$">
        <action application="bridge" data="sofia/gateway/kamailio/$1"/>
      </condition>
    </extension>
    
    <extension name="unloop">
      <condition field="${unroll_loops}" expression="^true$"/>
      <condition field="${sip_looped_call}" expression="^true$">
	<action application="deflect" data="${destination_number}"/>
      </condition>
    </extension>
  </context>
</include>
