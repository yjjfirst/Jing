<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="configuration">
      <param name="gateway-url" value="http://localhost:9091/fsapi" bindings="configuration"/>
    </binding>
    <binding name="directory">
      <param name="gateway-url" value="http://localhost:9091/fsapi" bindings="directory"/>
    </binding>
    <binding name="dialplan">
      <param name="gateway-url" value="http://localhost:9091/fsapi" bindings="dialplan"/>
      </binding>
  </bindings>
</configuration>
